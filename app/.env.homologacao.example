# Copie para .env.homologacao e preencha os segredos (este arquivo NÃO vai para a imagem)

# --- Docker Compose ---
IMAGE_NAME=novo-portal-aluno
IMAGE_TAG=hml
APP_PORT=8081

# --- Aplicação ---
APP_NAME="Portal do Aluno"
APP_ENV=staging
# Gere com: docker run --rm novo-portal-aluno:hml php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Porto_Velho
APP_URL=https://hml-portal-aluno.exemplo.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# Senhas da tabela legada portal.users: sha1(salt . senha)
# LEGACY_PASSWORD_SALT = Security.salt do sistema legado (CakePHP)
HASH_DRIVER=legacy-sha1
LEGACY_PASSWORD_SALT=

LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# --- Redis (serviço "redis" do compose) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=trocar-senha-redis
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=portal_aluno_hml
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="nao-responda@exemplo.com.br"
MAIL_FROM_NAME="Portal do Aluno"


# --- e-cidade (webservice SOAP; mesmos valores de SOAP_URI/SOAP_LOCATION do legado) ---
ECIDADE_DRIVER=soap
ECIDADE_SOAP_URI=https://e-cidade.portovelho.ro.gov.br
# Padrão: ${ECIDADE_SOAP_URI}/webservices/requisicao.webservice.php
ECIDADE_SOAP_LOCATION=
ECIDADE_TIMEOUT=20
ECIDADE_VERIFY_SSL=true
ECIDADE_CACHE_TTL=600

# --- Portal do Aluno ---
PORTAL_ORGAO="Secretaria Municipal de Educação"
# Primeiro acesso: pede a data de nascimento ao criar a senha (senha inicial = código do aluno)
PORTAL_CONFIRMAR_NASCIMENTO=true
PORTAL_EMAIL_LINK_HORAS=24
