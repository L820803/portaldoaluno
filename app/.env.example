# Ambiente local (docker-compose.yaml na raiz do repositório).
# Copie para .env e rode: php artisan key:generate && php artisan migrate

APP_NAME="Portal do Aluno"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Porto_Velho
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Senhas dos usuários (storage/app/private/usuarios.json): sha1(salt . senha)
HASH_DRIVER=legacy-sha1
# Salt do legado (Security.salt em app/config/core.php do portaldoaluno)
LEGACY_PASSWORD_SALT=salt-local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- e-cidade ---
# "fake" usa database/fixtures/ecidade (dados fictícios); "soap" chama o webservice real.
# Para usar o e-cidade (o mesmo do legado): ECIDADE_DRIVER=soap e a URI abaixo.
ECIDADE_DRIVER=fake
ECIDADE_SOAP_URI=https://e-cidade.portovelho.ro.gov.br
ECIDADE_SOAP_LOCATION=
ECIDADE_TIMEOUT=20
ECIDADE_VERIFY_SSL=true
ECIDADE_CACHE_TTL=600

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=portal_aluno_local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail: Mailpit do docker-compose (caixa de entrada em http://localhost:8025) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responda@portovelho.ro.gov.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Portal do Aluno ---
PORTAL_ORGAO="Secretaria Municipal de Educação"
# Primeiro acesso: pede a data de nascimento ao criar a senha (senha inicial = código do aluno)
PORTAL_CONFIRMAR_NASCIMENTO=true
PORTAL_EMAIL_LINK_HORAS=24
